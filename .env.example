# ═══════════════════════════════════════════════════════
#  CodeAtlas — Environment Configuration TEMPLATE
#  Copy this to .env and fill in your values
# ═══════════════════════════════════════════════════════

# ── Gemini API Keys ────────────────────────────────────────────────────────
# Add up to 4 (or more) keys for automatic rate-limit rotation.
# Get free keys at: https://aistudio.google.com/apikey
GEMINI_API_KEY_1=your_first_key_here
GEMINI_API_KEY_2=your_second_key_here
GEMINI_API_KEY_3=your_third_key_here
GEMINI_API_KEY_4=your_fourth_key_here

# Legacy fallback (used if no _N keys are set)
GEMINI_API_KEY=your_key_here

# ── Model ─────────────────────────────────────────────────────────────────
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_EMBEDDING_MODEL=models/gemini-embedding-001

# ── AI Performance & Quota Optimization ────────────────────────────────────
# AI_BATCH_SUMMARIZE_PER_FILE: When true, batches summaries per file in 1 structured call,
# reducing total API calls from 70+ down to ~5 (one per file). Maximum speed & accuracy.
AI_BATCH_SUMMARIZE_PER_FILE=true

# AI_DELAY_BETWEEN_CALLS: Delay (seconds) between calls to prevent rate spikes.
AI_DELAY_BETWEEN_CALLS=0.15

# ── Upload ────────────────────────────────────────────────────────────────
MAX_UPLOAD_MB=50

# ── Database (Free Cloud PostgreSQL like Neon.tech or Supabase) ───────────
# If left blank, defaults to local SQLite (codeatlas.db).
# Paste your Neon.tech connection string here:
DATABASE_URL=

# ── Storage ───────────────────────────────────────────────────────────────
SESSION_DIR=sessions
CHROMA_DIR=chroma_store

# ── CORS ──────────────────────────────────────────────────────────────────
CORS_ORIGINS=*

# ── Optional: Tavily API (web search in report, leave blank for DuckDuckGo)
TAVILY_API_KEY=
